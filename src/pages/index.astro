---
// Auto-generated tracker page - DO NOT EDIT MANUALLY
// This file is rebuilt on every GitHub Actions run
import { readFileSync } from 'fs';
import { join } from 'path';

const trackerHtmlPath = join(process.cwd(), 'data', 'site', 'index.html');
let trackerHtml = '';

try {
  const raw = readFileSync(trackerHtmlPath, 'utf-8');
  // Extract body content
  const bodyMatch = raw.match(/<body[^>]*>([\s\S]*?)<\/body>/);
  const bodyContent = bodyMatch ? bodyMatch[1] : raw;
  // Extract styles
  const styleMatch = raw.match(/<style[^>]*>([\s\S]*?)<\/style>/);
  const styleContent = styleMatch ? styleMatch[1] : '';
  trackerHtml = `<style is:global>${styleContent}</style>${bodyContent}`;
} catch (e) {
  // Fallback if no data yet
  trackerHtml = '<div style="padding:40px;color:#fff;text-align:center;font-family:sans-serif;"><h2>数据加载中...</h2><p>首次构建可能需要几分钟，请稍后刷新。</p></div>';
}
---
<div set:html={trackerHtml} />

<script>
  // Particle + parallax effects
  let mx = 0, my = 0;
  document.documentElement.style.setProperty('--mx', '0px');
  document.documentElement.style.setProperty('--my', '0px');
  window.addEventListener('mousemove', e => {
    const rx = (e.clientX / window.innerWidth - 0.5) * 12;
    const ry = (e.clientY / window.innerHeight - 0.5) * 8;
    document.documentElement.style.setProperty('--mx', rx + 'px');
    document.documentElement.style.setProperty('--my', ry + 'px');
    const bg = document.querySelector('.scene-bg');
    if (bg) bg.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0) scale(1.02)';
  });

  function initParticles() {
    const existing = document.getElementById('qi');
    if (existing) return;
    const canvas = document.createElement('canvas');
    canvas.id = 'qi';
    canvas.style.cssText = 'position:fixed;inset:0;z-index:2;pointer-events:none';
    document.body.prepend(canvas);
    const ctx = canvas.getContext('2d');
    let pts = [];
    function resize() {
      const dpr = Math.min(devicePixelRatio, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = window.innerWidth + 'px';
      canvas.style.height = window.innerHeight + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function spawn(x, y) {
      for (let i = 0; i < 5; i++)
        pts.push({ x, y, tx: x + (Math.random() - 0.5) * 60, ty: y + (Math.random() - 0.5) * 60, life: 35 + Math.random() * 20, r: 1 + Math.random() * 2 });
      if (pts.length > 120) pts = pts.slice(-120);
    }
    window.addEventListener('mousemove', e => spawn(e.clientX, e.clientY));
    function tick() {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      pts.forEach(p => {
        p.x += (p.tx - p.x) * 0.028;
        p.y += (p.ty - p.y) * 0.028;
        p.life -= 0.8;
        ctx.fillStyle = `rgba(180,210,255,${Math.max(0, p.life / 55)})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      });
      pts = pts.filter(p => p.life > 0);
      requestAnimationFrame(tick);
    }
    resize();
    tick();
    window.addEventListener('resize', resize);
  }
  initParticles();
</script>